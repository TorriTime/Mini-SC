{
  "manifest_version": 3,
  "name": "Krillion FR → EN Express",
  "version": "1.3.0",
  "permissions": ["storage"],
  "description": "Barre flottante : tape en français, Entrée, la traduction anglaise est envoyée dans Krillion.io. Traduit la question et le chat, mémorise tes réponses.",
  "browser_specific_settings": {
    "gecko": {
      "id": "krillion-fr-en@mini-sc.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["websiteContent"] }
    }
  },
  "host_permissions": [
    "https://krillion.io/*",
    "https://*.krillion.io/*",
    "https://translate.googleapis.com/*",
    "https://api.mymemory.translated.net/*",
    "https://*.wikipedia.org/*",
    "https://api.dictionaryapi.dev/*",
    "https://api.duckduckgo.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://krillion.io/*", "https://*.krillion.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
